{"$schema": "http://json-schema.org/draft-07/schema#", "required": ["meta", "examFormat", "chapters", "questions"], "properties": {"meta": {"required": ["country", "languages", "packVersion", "lawValidThrough", "sources"], "properties": {"country": {"type": "string", "pattern": "^[a-z]{2}$"}, "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "packVersion": {"type": "string"}, "lawValidThrough": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}, "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}, "examFormat": {"required": ["questionCount", "timeLimitSec", "passMinCorrect"], "properties": {"questionCount": {"type": "integer", "minimum": 1}, "timeLimitSec": {"type": "integer", "minimum": 60}, "passMinCorrect": {"type": "integer", "minimum": 1}}}, "chapters": {"type": "array", "minItems": 1, "items": {"required": ["id", "title"], "properties": {"id": {"type": "string"}, "title": {"type": "object"}}}}, "questions": {"type": "array", "items": {"required": ["id", "chapter", "type", "stem", "options", "correct", "explanation", "article"], "properties": {"id": {"type": "string"}, "chapter": {"type": "string"}, "type": {"enum": ["single", "multi"]}, "stem": {"type": "object"}, "options": {"type": "object"}, "correct": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "explanation": {"type": "object"}, "article": {"type": "string"}, "difficulty": {"type": "integer", "minimum": 1, "maximum": 3}, "media": {"type": ["string", "null"]}}}}}}